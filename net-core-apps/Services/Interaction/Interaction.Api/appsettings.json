{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Runtime": { "Role": "Api" },
  "Traffic": {
    "RequestTimeoutSeconds": 10,
    "MaxConcurrentRequestsPerReplica": 256,
    "MaxRequestBodyBytes": 262144,
    "MaxMultipartBodyBytes": 262144,
    "ForwardLimit": 2,
    "KnownProxies": []
  },
  "Identity": {
    "ClientId": "interaction_api",
    "ClientSecret": "{{secret:IdentityClientSecret}}",
    "ValidationMode": "Introspection",
    "Audience": "interaction_api",
    "AuthoritativeExportScope": "interaction.authority.export"
  },
  "AuthoritativeExport": {
    "CursorSigningKey": "{{secret:AuthoritativeExportCursorSigningKey}}",
    "CursorLifetimeMinutes": 360
  },
  "Broker": {
    "Provider": "MassTransit",
    "Transport": "RabbitMq",
    "OutboxTelemetry": {
      "Enabled": true,
      "IntervalSeconds": 15,
      "QueryTimeoutSeconds": 5,
      "MaximumPendingMessages": 300000,
      "MaximumOldestMessageAgeSeconds": 300,
      "MaximumSampleAgeSeconds": 45
    },
    "RabbitMq": {
      "host": "",
      "port": 5672,
      "username": "",
      "password": "{{secret:BrokerPassword}}",
      "virtualHost": "",
      "prefetchCount": 32,
      "consumerConcurrency": 16,
      "heartbeatSeconds": 30,
      "tls": { "enabled": true, "serverName": "" }
    }
  },
  "Database": {
    "MariaDbSqlConnection": "{{secret:DatabaseConnectionString}}",
    "RequireTls": true,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 30,
    "SlowQueryThresholdMilliseconds": 250,
    "ConnectionIdleTimeoutSeconds": 180,
    "ConnectionLifetimeSeconds": 900,
    "PoolSizes": {
      "Api": 6,
      "ConsumerWorker": 6,
      "JobWorker": 4,
      "Migration": 5,
      "Combined": 6
    }
  },
  "Privacy": { "ViewHashKey": "{{secret:ViewHashKey}}" },
  "Interaction": {
    "StatusBatchMaximum": 100,
    "ViewDedupeBucketSeconds": 900,
    "ViewObservationRetentionDays": 7,
    "ViewAggregationBatchSize": 500,
    "ViewAggregationPollSeconds": 2,
    "ReconciliationBatchSize": 100,
    "ReconciliationPollSeconds": 300,
    "AuthorityRevisionRetentionDays": 7,
    "AuthorityRevisionPruneBatchSize": 500,
    "ProjectionGapDrainMaximum": 64,
    "ErasureBatchSize": 100,
    "ErasurePollSeconds": 5,
    "ErasureLeaseSeconds": 120
  },
  "Cache": {
    "Enabled": true,
    "DefaultExpirationSeconds": 30,
    "DefaultLocalExpirationSeconds": 5,
    "MaximumKeyLength": 256,
    "MaximumPayloadBytes": 65536,
    "SourceConcurrencyLimit": 64,
    "SourceQueueTimeoutMilliseconds": 50,
    "Redis": {
      "Enabled": true,
      "ConnectionString": "{{secret:RedisConnectionString}}",
      "InstanceName": "inspacy-interaction:",
      "ConnectTimeoutMilliseconds": 1000,
      "OperationTimeoutMilliseconds": 250
    }
  },
  "SecretProvider": {
    "References": {
      "IdentityClientSecret": { "Namespace": "identityConfig", "Key": "interaction_client_secret", "Roles": [ "Api", "Combined" ] },
      "DatabaseConnectionString": { "Namespace": "interactionConfig", "Key": "sql_connection_string", "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Migration", "Combined" ] },
      "BrokerPassword": { "Namespace": "interactionConfig", "Key": "rmq_password", "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Combined" ] },
      "ViewHashKey": { "Namespace": "interactionConfig", "Key": "view_hash_key", "Roles": [ "Api", "Combined" ] },
      "AuthoritativeExportCursorSigningKey": { "Namespace": "interactionConfig", "Key": "authority_export_cursor_signing_key", "Roles": [ "Api", "Combined" ] },
      "RedisConnectionString": { "Namespace": "interactionConfig", "Key": "redis_connection_string", "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Combined" ] }
    }
  }
}
