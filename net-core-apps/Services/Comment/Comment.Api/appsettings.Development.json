{
  "Runtime": {
    "Role": "Combined"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Identity": {
    "ServiceUrl": "http://localhost:5000/",
    "ClientSecret": ""
  },
  "Following": {
    "ServiceUrl": "http://localhost:5040/",
    "RequestTimeoutSeconds": 15,
    "Snapshot": {
      "ClientId": "comment_relationship_snapshot_job",
      "ClientSecret": "",
      "ReadScope": "following_api:read"
    }
  },
  "CommentCursor": {
    "SigningKey": "",
    "LifetimeSeconds": 86400
  },
  "Database": {
    "MariaDbSqlConnection": "",
    "RequireTls": false
  },
  "Storage": {
    "OciConnection": "",
    "MediaSecurity": {
      "RequireMalwareScan": false,
      "ClamAvPort": 3310,
      "ConnectTimeoutSeconds": 2,
      "ScanTimeoutSeconds": 30,
      "ChunkBytes": 16384,
      "MaximumConcurrentScansPerReplica": 4,
      "CircuitBreakerFailureThreshold": 3,
      "CircuitBreakerOpenSeconds": 30,
      "ReadinessProbeTimeoutSeconds": 2
    },
    "Minio": {
      "enabled": true,
      "endpoint": "127.0.0.1:9000",
      "accessKey": "",
      "secretKey": "",
      "bucket": "inspacy-storage",
      "useSSL": false,
      "publicUrl": "http://localhost:9000",
      "createBucket": true,
      "allowPublicRead": false,
      "maximumUploadBytes": 33554432
    }
  },
  "Broker": {
    "RabbitMq": {
      "host": "127.0.0.1",
      "port": 5672,
      "username": "guest",
      "password": "",
      "virtualHost": "inspacy",
      "tls": {
        "enabled": false
      }
    }
  }
}
