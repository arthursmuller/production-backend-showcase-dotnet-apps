{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Runtime": {
    "Role": "Api"
  },
  "Traffic": {
    "RequestTimeoutSeconds": 30,
    "MaxConcurrentRequestsPerReplica": 256,
    "MaxRequestBodyBytes": 2097152,
    "MaxMultipartBodyBytes": 33554432,
    "ForwardLimit": 2,
    "KnownProxies": [],
    "AuthenticatedWritePermitLimitPerMinute": 60,
    "AuthenticatedWritePartitionCount": 4096,
    "AnonymousViewPermitLimitPerMinute": 600,
    "AnonymousViewPartitionCount": 4096
  },
  "Storage": {
    "OciConnection": "{{secret:StorageOciConnection}}",
    "MediaSecurity": {
      "RequireMalwareScan": true,
      "ClamAvHost": "clamav.media-security.svc.cluster.local",
      "ClamAvPort": 3310,
      "ConnectTimeoutSeconds": 2,
      "ScanTimeoutSeconds": 30,
      "ChunkBytes": 16384,
      "MaximumConcurrentScansPerReplica": 4,
      "CircuitBreakerFailureThreshold": 3,
      "CircuitBreakerOpenSeconds": 30,
      "ReadinessProbeTimeoutSeconds": 2
    },
    "Minio": {
      "enabled": false,
      "endpoint": "",
      "accessKey": "",
      "secretKey": "",
      "bucket": "",
      "useSSL": false,
      "publicUrl": ""
    }
  },
  "Identity": {
    "ClientId": "comment_api",
    "ClientSecret": "{{secret:IdentityClientSecret}}",
    "ValidationMode": "Introspection",
    "Audience": "comment_api"
  },
  "Following": {
    "ServiceUrl": "http://following-api.following.svc.cluster.local:8080/",
    "RequestTimeoutSeconds": 15,
    "Snapshot": {
      "ClientId": "comment_relationship_snapshot_job",
      "ClientSecret": "{{secret:FollowingSnapshotClientSecret}}",
      "ReadScope": "following_api:read"
    }
  },
  "CommentAudienceProjection": {
    "EnableReadEnforcement": false,
    "SnapshotPageSize": 500,
    "MaximumTwoHopFirstHop": 256,
    "MaximumCheckpointAgeSeconds": 86400,
    "MaximumBootstrapAgeSeconds": 86400,
    "BootstrapIntervalSeconds": 21600,
    "BootstrapRetrySeconds": 15,
    "BootstrapPageDelayMilliseconds": 50,
    "BootstrapLeaseSeconds": 60,
    "AuthorizationDeadlineMilliseconds": 750,
    "ConsumerPrefetchCount": 64,
    "ConsumerConcurrencyLimit": 32
  },
  "CommentUserErasure": {
    "BatchSize": 50,
    "MaximumRowsPerCycle": 400,
    "MaximumBatchesPerCycle": 12,
    "CycleTimeBudgetMilliseconds": 4000,
    "LeaseSeconds": 30,
    "ActiveDelayMilliseconds": 100,
    "IdleDelayMilliseconds": 2000,
    "FailureDelayMilliseconds": 5000,
    "MaximumPendingAgeMinutes": 15
  },
  "Broker": {
    "Provider": "MassTransit",
    "Transport": "RabbitMq",
    "OutboxTelemetry": {
      "Enabled": true,
      "IntervalSeconds": 15,
      "QueryTimeoutSeconds": 5,
      "MaximumPendingMessages": 100000,
      "MaximumOldestMessageAgeSeconds": 300,
      "MaximumSampleAgeSeconds": 45
    },
    "RabbitMq": {
      "host": "",
      "port": 5672,
      "username": "",
      "password": "{{secret:BrokerPassword}}",
      "virtualHost": "",
      "prefetchCount": 32,
      "consumerConcurrency": 16,
      "heartbeatSeconds": 30,
      "tls": {
        "enabled": true,
        "serverName": ""
      }
    }
  },
  "CommentMediaIngestion": {
    "ReconciliationBatchSize": 20,
    "MaximumAttempts": 10,
    "LeaseDuration": "00:02:00",
    "RequestRecoveryDelay": "00:05:00",
    "FirstRetryDelay": "00:00:05",
    "MaximumRetryDelay": "00:05:00",
    "PendingAbandonment": "00:30:00",
    "PromotedOrphanRetention": "1.00:00:00",
    "TerminalRetention": "30.00:00:00",
    "IdleDelay": "00:00:05",
    "ActiveDelay": "00:00:00.250",
    "FailureDelay": "00:00:10",
    "CleanupInterval": "01:00:00"
  },
  "Database": {
    "MariaDbSqlConnection": "{{secret:DatabaseConnectionString}}",
    "RequireTls": true,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 30,
    "SlowQueryThresholdMilliseconds": 250,
    "ConnectionIdleTimeoutSeconds": 180,
    "ConnectionLifetimeSeconds": 900,
    "PoolSizes": {
      "Api": 8,
      "ConsumerWorker": 8,
      "JobWorker": 4,
      "Migration": 5,
      "Combined": 8
    }
  },
  "CommentCursor": {
    "SigningKey": "{{secret:CommentCursorSigningKey}}",
    "LifetimeSeconds": 86400
  },
  "SecretProvider": {
    "References": {
      "IdentityClientSecret": {
        "Namespace": "identityConfig",
        "Key": "comment_client_secret",
        "Roles": [ "Api", "Combined" ]
      },
      "FollowingSnapshotClientSecret": {
        "Namespace": "identityConfig",
        "Key": "comment_relationship_snapshot_client_secret",
        "Roles": [ "JobWorker", "Combined" ]
      },
      "DatabaseConnectionString": {
        "Namespace": "commentConfig",
        "Key": "sql_connection_string",
        "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Migration", "Combined" ]
      },
      "BrokerPassword": {
        "Namespace": "commentConfig",
        "Key": "rmq_password",
        "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Combined" ]
      },
      "CommentCursorSigningKey": {
        "Namespace": "commentConfig",
        "Key": "cursor_signing_key",
        "Roles": [ "Api", "Combined" ]
      },
      "StorageOciConnection": {
        "Namespace": "commentConfig",
        "Key": "storage_oci_connection",
        "Roles": [ "Api", "JobWorker", "Combined" ]
      }
    }
  },
  "MaxMultipartBodyBytes": 33554432
}
