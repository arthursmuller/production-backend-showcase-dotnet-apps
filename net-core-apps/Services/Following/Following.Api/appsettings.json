{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Runtime": {
    "Role": "Api"
  },
  "Traffic": {
    "RequestTimeoutSeconds": 30,
    "MaxConcurrentRequestsPerReplica": 256,
    "MaxRequestBodyBytes": 2097152,
    "MaxMultipartBodyBytes": 33554432,
    "ForwardLimit": 2,
    "KnownProxies": []
  },
  "Identity": {
    "ClientId": "following_api",
    "ClientSecret": "{{secret:IdentityClientSecret}}",
    "ValidationMode": "Introspection",
    "Audience": "following_api"
  },
  "Following": {
    "ReadScope": "following_api:read"
  },
  "FollowingCursor": {
    "SigningKey": "{{secret:FollowingCursorSigningKey}}",
    "LifetimeSeconds": 86400
  },
  "FollowingUserErasure": {
    "BatchSize": 100,
    "MaxBatchesPerCycle": 8,
    "CycleTimeBudgetMilliseconds": 5000,
    "LeaseSeconds": 30,
    "ActiveDelayMilliseconds": 100,
    "IdleDelayMilliseconds": 2000,
    "FailureDelayMilliseconds": 5000,
    "MaxPendingAgeMinutes": 15
  },
  "Categories": {
    "ReadScope": "categories_api:read"
  },
  "Broker": {
    "Provider": "MassTransit",
    "Transport": "RabbitMq",
    "OutboxTelemetry": {
      "Enabled": true,
      "IntervalSeconds": 15,
      "QueryTimeoutSeconds": 5,
      "MaximumPendingMessages": 60000,
      "MaximumOldestMessageAgeSeconds": 300,
      "MaximumSampleAgeSeconds": 45
    },
    "RabbitMq": {
      "host": "",
      "port": 5672,
      "username": "",
      "password": "{{secret:BrokerPassword}}",
      "virtualHost": "",
      "prefetchCount": 32,
      "consumerConcurrency": 16,
      "heartbeatSeconds": 30,
      "tls": {
        "enabled": true,
        "serverName": ""
      }
    }
  },
  "Database": {
    "MariaDbSqlConnection": "{{secret:DatabaseConnectionString}}",
    "RequireTls": true,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 30,
    "SlowQueryThresholdMilliseconds": 250,
    "ConnectionIdleTimeoutSeconds": 180,
    "ConnectionLifetimeSeconds": 900,
    "PoolSizes": {
      "Api": 8,
      "ConsumerWorker": 8,
      "JobWorker": 4,
      "Migration": 5,
      "Combined": 8
    }
  },
  "SecretProvider": {
    "References": {
      "IdentityClientSecret": {
        "Namespace": "identityConfig",
        "Key": "following_client_secret",
        "Roles": [ "Api", "Combined" ]
      },
      "DatabaseConnectionString": {
        "Namespace": "followingConfig",
        "Key": "sql_connection_string",
        "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Migration", "Combined" ]
      },
      "BrokerPassword": {
        "Namespace": "followingConfig",
        "Key": "rmq_password",
        "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Combined" ]
      },
      "FollowingCursorSigningKey": {
        "Namespace": "followingConfig",
        "Key": "cursor_signing_key",
        "Roles": [ "Api", "Combined" ]
      }
    }
  }
}
