<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UserSecretsId>9380ca2e-4a17-4a75-9cfd-9fb871dc680d</UserSecretsId>
    <RootNamespace>Following.API</RootNamespace>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerComposeProjectPath>..\..\..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Logging" Version="8.16.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.MySQL" Version="5.0.0" />
    <!-- Override vulnerable transitive MySql.Data 8.0.33 (System.Drawing.Common chain). -->
    <PackageReference Include="MySql.Data" Version="9.7.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\ApiKit\ApiHost\ApiHost.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\ApiKit\CommomStartupExtensions\CommomStartupExtensions.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\ApiKit\Cqrs\Cqrs.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\SqlKit\EfCoreFilters\EfCoreFilters.csproj" />
    <ProjectReference Include="..\Following.Application\Following.Application.csproj" />
    <ProjectReference Include="..\Following.Infraestructure\Following.Infraestructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
