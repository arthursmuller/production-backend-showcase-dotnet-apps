{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "moderation.api",
  "Runtime": {
    "Role": "Api"
  },
  "Traffic": {
    "RequestTimeoutSeconds": 30,
    "MaxConcurrentRequestsPerReplica": 256,
    "MaxRequestBodyBytes": 262144,
    "MaxMultipartBodyBytes": 262144,
    "ForwardLimit": 2,
    "KnownProxies": []
  },
  "Identity": {
    "ClientId": "moderation_api",
    "ClientSecret": "{{secret:IdentityClientSecret}}",
    "ValidationMode": "Introspection",
    "Audience": "moderation_api",
    "DecisionExportScope": "moderation.decision.export"
  },
  "DecisionExport": {
    "CursorSigningKey": "{{secret:DecisionExportCursorSigningKey}}",
    "CursorLifetimeMinutes": 360,
    "RevisionRetention": {
      "RetentionDays": 7,
      "MaxBatchSize": 500
    }
  },
  "Broker": {
    "Provider": "MassTransit",
    "Transport": "RabbitMq",
    "OutboxTelemetry": {
      "Enabled": true,
      "IntervalSeconds": 15,
      "QueryTimeoutSeconds": 5,
      "MaximumPendingMessages": 10000,
      "MaximumOldestMessageAgeSeconds": 300,
      "MaximumSampleAgeSeconds": 45
    },
    "RabbitMq": {
      "host": "",
      "port": 5671,
      "username": "",
      "password": "{{secret:BrokerPassword}}",
      "virtualHost": "",
      "prefetchCount": 32,
      "consumerConcurrency": 16,
      "heartbeatSeconds": 30,
      "tls": {
        "enabled": true,
        "serverName": ""
      }
    }
  },
  "Database": {
    "MariaDbSqlConnection": "{{secret:DatabaseConnectionString}}",
    "RequireTls": true,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 30,
    "SlowQueryThresholdMilliseconds": 250,
    "ConnectionIdleTimeoutSeconds": 180,
    "ConnectionLifetimeSeconds": 900,
    "PoolSizes": {
      "Api": 8,
      "ConsumerWorker": 8,
      "JobWorker": 4,
      "Migration": 5,
      "Combined": 8
    }
  },
  "Moderation": {
    "Privacy": {
      "SubjectLookupKey": "{{secret:PrivacySubjectLookupKey}}"
    },
    "Erasure": {
      "Enabled": false,
      "ApprovalReference": "",
      "PollIntervalSeconds": 30,
      "MaxBatchSize": 100,
      "LeaseSeconds": 120,
      "LegalHoldReviewSeconds": 86400
    },
    "Retention": {
      "Enabled": false,
      "ApprovalReference": "",
      "ReportsAndCasesDays": 730,
      "AuditDays": 2555,
      "PollIntervalSeconds": 300,
      "MaxBatchSize": 100,
      "LeaseSeconds": 120
    },
    "Sla": {
      "ReceivedMinutes": 240,
      "LowPriorityMinutes": 2880,
      "NormalPriorityMinutes": 1440,
      "HighPriorityMinutes": 240,
      "CriticalPriorityMinutes": 60,
      "InvestigationMinutes": 1440,
      "DecisionMinutes": 480,
      "AppealMinutes": 1440
    },
    "Escalation": {
      "PollIntervalSeconds": 30,
      "MaxBatchSize": 100
    }
  },
  "SecretProvider": {
    "References": {
      "IdentityClientSecret": {
        "Namespace": "identityConfig",
        "Key": "moderation_client_secret",
        "Roles": [ "Api", "Combined" ]
      },
      "DatabaseConnectionString": {
        "Namespace": "moderationConfig",
        "Key": "sql_connection_string",
        "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Migration", "Combined" ]
      },
      "BrokerPassword": {
        "Namespace": "moderationConfig",
        "Key": "rmq_password",
        "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Combined" ]
      },
      "DecisionExportCursorSigningKey": {
        "Namespace": "moderationConfig",
        "Key": "decision_export_cursor_signing_key",
        "Roles": [ "Api", "Combined" ]
      },
      "PrivacySubjectLookupKey": {
        "Namespace": "moderationConfig",
        "Key": "privacy_subject_lookup_key",
        "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Combined" ]
      }
    }
  }
}
