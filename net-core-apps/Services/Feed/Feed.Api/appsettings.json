{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Runtime": {
    "Role": "Api"
  },
  "Traffic": {
    "RequestTimeoutSeconds": 30,
    "MaxConcurrentRequestsPerReplica": 256,
    "MaxRequestBodyBytes": 2097152,
    "MaxMultipartBodyBytes": 33554432,
    "ForwardLimit": 2,
    "KnownProxies": []
  },
  "AudienceProjection": {
    "MaximumBootstrapPageSize": 500,
    "MaximumQuarantineDrain": 100,
    "MaximumCheckpointAgeSeconds": 86400,
    "MaximumBootstrapAgeSeconds": 3600,
    "BootstrapIntervalSeconds": 300,
    "BootstrapRetrySeconds": 15,
    "BootstrapPageDelayMilliseconds": 50,
    "BootstrapLeaseSeconds": 60,
    "AuthorizationDeadlineMilliseconds": 500,
    "MaximumFriendsOfFriendsCandidates": 256,
    "MaximumFriendsOfFriendsFanoutBatchSize": 100
  },
  "Feed": {
    "EnableFirstPageCache": true,
    "PullEnterAudienceCount": 100000,
    "PullExitAudienceCount": 80000,
    "MaximumPullPublishers": 64,
    "MaximumCandidates": 512,
    "MaximumCandidatesPerPullPublisher": 8,
    "MaximumMaterializedRows": 2048,
    "MaximumProcessedRows": 8192,
    "ReadDeadlineMilliseconds": 1500,
    "MergeDeadlineMilliseconds": 100,
    "MaximumSerializedResponseBytes": 262144,
    "MaximumPageSize": 50,
    "FanoutBatchSize": 500,
    "FanoutClaimBatchSize": 16,
    "RevocationBatchSize": 500,
    "LeaseSeconds": 30,
    "MaximumAttempts": 20,
    "WorkerIntervalMilliseconds": 500,
    "MaintenanceIntervalSeconds": 300,
    "EntryRetentionDays": 30,
    "CompletedWorkRetentionDays": 7,
    "FirstPageCacheSeconds": 15,
    "FirstPageLocalCacheSeconds": 5,
    "MaximumCursorLength": 512,
    "MaximumCheckpointAgeSeconds": 86400
  },
  "FeedUserErasure": {
    "BatchSize": 100,
    "MaximumRowsPerCycle": 800,
    "MaximumBatchesPerCycle": 16,
    "CycleTimeBudgetMilliseconds": 5000,
    "LeaseSeconds": 30,
    "ActiveDelayMilliseconds": 100,
    "IdleDelayMilliseconds": 2000,
    "FailureDelayMilliseconds": 5000,
    "MaximumPendingAgeMinutes": 15,
    "CacheExpirySafetySeconds": 2
  },
  "FeedCursor": {
    "ActiveKeyId": "primary",
    "SigningKeys": {
      "primary": "{{secret:FeedCursorSigningKey}}"
    },
    "LifetimeSeconds": 900,
    "ClockSkewSeconds": 15
  },
  "Identity": {
    "ValidationMode": "Introspection",
    "Audience": "feed_api"
  },
  "Following": {
    "Snapshot": {
      "ClientId": "feed_relationship_snapshot_job",
      "ClientSecret": "{{secret:FollowingSnapshotClientSecret}}",
      "ReadScope": "following_api:read",
      "RequestTimeoutSeconds": 15
    }
  },
  "Broker": {
    "Provider": "MassTransit",
    "Transport": "RabbitMq",
    "OutboxTelemetry": {
      "Enabled": true,
      "IntervalSeconds": 15,
      "QueryTimeoutSeconds": 5,
      "MaximumPendingMessages": 250000,
      "MaximumOldestMessageAgeSeconds": 300,
      "MaximumSampleAgeSeconds": 45
    },
    "RabbitMq": {
      "host": "",
      "port": 5672,
      "username": "",
      "password": "{{secret:BrokerPassword}}",
      "virtualHost": "",
      "prefetchCount": 32,
      "consumerConcurrency": 16,
      "heartbeatSeconds": 30,
      "tls": {
        "enabled": true,
        "serverName": ""
      }
    }
  },
  "Database": {
    "MariaDbSqlConnection": "{{secret:DatabaseConnectionString}}",
    "RequireTls": true,
    "ConnectionTimeoutSeconds": 5,
    "CommandTimeoutSeconds": 30,
    "SlowQueryThresholdMilliseconds": 250,
    "ConnectionIdleTimeoutSeconds": 180,
    "ConnectionLifetimeSeconds": 900,
    "PoolSizes": {
      "Api": 8,
      "ConsumerWorker": 8,
      "JobWorker": 4,
      "Migration": 5,
      "Combined": 8
    }
  },
  "SecretProvider": {
    "References": {
      "FollowingSnapshotClientSecret": {
        "Namespace": "identityConfig",
        "Key": "feed_relationship_snapshot_client_secret",
        "Roles": [ "JobWorker", "Combined" ]
      },
      "FeedCursorSigningKey": {
        "Namespace": "feedConfig",
        "Key": "cursor_signing_key",
        "Roles": [ "Api", "Combined" ]
      },
      "DatabaseConnectionString": {
        "Namespace": "feedConfig",
        "Key": "sql_connection_string",
        "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Migration", "Combined" ]
      },
      "BrokerPassword": {
        "Namespace": "feedConfig",
        "Key": "rmq_password",
        "Roles": [ "Api", "ConsumerWorker", "JobWorker", "Combined" ]
      }
    }
  }
}
