{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspacy.local/schemas/performance-result.schema.json",
  "title": "Sanitized performance run result",
  "type": "object",
  "required": [
    "$schema", "schemaVersion", "domain", "workload", "profile", "runId",
    "targetEnvironment", "targetAuthority", "startedAtUtc", "finishedAtUtc",
    "durationSeconds", "configuredDurationSeconds", "configuredRecoverySeconds",
    "startConcurrency", "maximumConcurrency", "targetRequestsPerSecond",
    "arrivalModel", "totalRequests", "successfulRequests", "failedRequests",
    "throughputRequestsPerSecond", "errorRatePercent", "p50Milliseconds",
    "p95Milliseconds", "p99Milliseconds", "statusCodes", "failures",
    "operations", "runnerResources", "operationalObservations", "gate"
  ],
  "properties": {
    "$schema": { "const": "performance-result.schema.json" },
    "schemaVersion": { "const": "2.0" },
    "domain": { "type": "string", "minLength": 1, "maxLength": 64 },
    "workload": { "enum": ["load", "stress", "soak"] },
    "profile": { "enum": ["smoke", "baseline", "representative"] },
    "runId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._-]+$" },
    "targetEnvironment": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
    "targetAuthority": { "type": "string", "format": "uri", "maxLength": 512 },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "finishedAtUtc": { "type": "string", "format": "date-time" },
    "durationSeconds": { "type": "number", "minimum": 0 },
    "configuredDurationSeconds": { "type": "integer", "minimum": 1 },
    "configuredRecoverySeconds": { "type": "integer", "minimum": 0 },
    "startConcurrency": { "type": "integer", "minimum": 1 },
    "maximumConcurrency": { "type": "integer", "minimum": 1 },
    "targetRequestsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
    "arrivalModel": { "$ref": "#/$defs/arrivalModel" },
    "totalRequests": { "type": "integer", "minimum": 0 },
    "successfulRequests": { "type": "integer", "minimum": 0 },
    "failedRequests": { "type": "integer", "minimum": 0 },
    "throughputRequestsPerSecond": { "type": "number", "minimum": 0 },
    "errorRatePercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "p50Milliseconds": { "type": "number", "minimum": 0 },
    "p95Milliseconds": { "type": "number", "minimum": 0 },
    "p99Milliseconds": { "type": "number", "minimum": 0 },
    "statusCodes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "failures": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/operationResult" }
    },
    "runnerResources": { "$ref": "#/$defs/runnerResources" },
    "operationalObservations": { "$ref": "#/$defs/observations" },
    "gate": { "$ref": "#/$defs/gate" }
  },
  "additionalProperties": false,
  "$defs": {
    "nullableNumber": { "type": ["number", "null"] },
    "nullableInteger": { "type": ["integer", "null"] },
    "arrivalModel": {
      "type": "object",
      "required": [
        "kind", "scheduling", "initialTargetRequestsPerSecond",
        "peakTargetRequestsPerSecond", "burstEverySeconds",
        "burstDurationSeconds", "burstMultiplier"
      ],
      "properties": {
        "kind": { "enum": ["paced-fixed-rate", "linear-concurrency-ramp-with-recovery", "periodic-burst"] },
        "scheduling": { "type": "string", "minLength": 1, "maxLength": 160 },
        "initialTargetRequestsPerSecond": { "type": "number", "minimum": 0 },
        "peakTargetRequestsPerSecond": { "type": "number", "minimum": 0 },
        "burstEverySeconds": { "$ref": "#/$defs/nullableInteger" },
        "burstDurationSeconds": { "$ref": "#/$defs/nullableInteger" },
        "burstMultiplier": { "$ref": "#/$defs/nullableNumber" }
      },
      "additionalProperties": false
    },
    "operationResult": {
      "type": "object",
      "required": [
        "name", "method", "configuredWeight", "totalRequests", "successfulRequests",
        "failedRequests", "errorRatePercent", "p50Milliseconds", "p95Milliseconds", "p99Milliseconds"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
        "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"] },
        "configuredWeight": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "totalRequests": { "type": "integer", "minimum": 0 },
        "successfulRequests": { "type": "integer", "minimum": 0 },
        "failedRequests": { "type": "integer", "minimum": 0 },
        "errorRatePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "p50Milliseconds": { "type": "number", "minimum": 0 },
        "p95Milliseconds": { "type": "number", "minimum": 0 },
        "p99Milliseconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "runnerResources": {
      "type": "object",
      "required": ["cpuPercent", "peakWorkingSetMegabytes"],
      "properties": {
        "cpuPercent": { "type": "number", "minimum": 0 },
        "peakWorkingSetMegabytes": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "object",
      "required": [
        "dependencySaturationPercent", "targetCpuPercent", "targetWorkingSetMegabytes",
        "freshnessLagMilliseconds", "backlogCount"
      ],
      "properties": {
        "dependencySaturationPercent": { "$ref": "#/$defs/nullableNumber" },
        "targetCpuPercent": { "$ref": "#/$defs/nullableNumber" },
        "targetWorkingSetMegabytes": { "$ref": "#/$defs/nullableNumber" },
        "freshnessLagMilliseconds": { "$ref": "#/$defs/nullableNumber" },
        "backlogCount": { "$ref": "#/$defs/nullableInteger" }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["configured", "passed", "checks"],
      "properties": {
        "configured": { "type": "boolean" },
        "passed": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "passed", "actual", "expected"],
            "properties": {
              "name": { "type": "string" },
              "passed": { "type": "boolean" },
              "actual": { "type": "string" },
              "expected": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
