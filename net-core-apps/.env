FEED_ConnectionString="Data Source=mariadbData;port=3306;Database=Inspacy.Feed;uid=root;password=a608e2b2Q!"
FOLLOWING_ConnectionString="Data Source=mariadbData;port=3306;Database=Inspacy.Following;uid=root;password=a608e2b2Q!"

# RabbitMQ
RMQ_CONNECTION_COMMENT="{\"username\":\"arthur\",\"pw\":\"a608e2b2\",\"port\":5672,\"host\":\"rabbitmq\",\"vhost\":\"inspacy\",\"exchange\":\"comment.events\",\"delayExchange\":\"inspacy.delayed\",\"retrycount\":5}"
RMQ_CONNECTION_FEED="{\"username\":\"arthur\",\"pw\":\"a608e2b2\",\"port\":5672,\"host\":\"rabbitmq\",\"vhost\":\"inspacy\",\"exchange\":\"feed.events\",\"delayExchange\":\"inspacy.delayed\",\"retrycount\":5}"
RMQ_CONNECTION_FOLLOWING="{\"username\":\"arthur\",\"pw\":\"a608e2b2\",\"port\":5672,\"host\":\"rabbitmq\",\"vhost\":\"inspacy\",\"exchange\":\"following.events\",\"delayExchange\":\"inspacy.delayed\",\"retrycount\":5}"

